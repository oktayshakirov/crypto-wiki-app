    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#171717"
        }
      ],
      "expo-tracking-transparency",
      "expo-font",
      "expo-web-browser",
      "expo-mail-composer",
      "./plugins/withRestrictedResizability",
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "PortfolioWidget",
              "label": "Portfolio Value",
              "description": "Your portfolio value and profit/loss at a glance.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "maxResizeWidth": "360dp",
              "maxResizeHeight": "300dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FearGreedWidget",
              "label": "Fear & Greed (Pro)",
              "description": "Crypto Fear & Greed Index. Requires Pro - upgrade inside the app.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000
            },
            {
              "name": "HeatmapWidget",
              "label": "Crypto Heatmap (Pro)",
              "description": "Top coins by market cap, colored by 24h change. Requires Pro - upgrade inside the app.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "360dp",
              "maxResizeHeight": "360dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "LatestPostWidget",
              "label": "Latest Post (Pro)",
              "description": "The newest article from TheCrypto.wiki. Requires Pro - upgrade inside the app.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 21600000
            },
            {
              "name": "LatestExchangeWidget",
              "label": "Latest Exchange (Pro)",
              "description": "The newest exchange review from TheCrypto.wiki. Requires Pro - upgrade inside the app.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 21600000
            },
            {
              "name": "LatestOGWidget",
              "label": "Latest OG (Pro)",
              "description": "The newest crypto OG profile from TheCrypto.wiki. Requires Pro - upgrade inside the app.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 21600000
            }
          ]
        }
